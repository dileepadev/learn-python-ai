---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import LessonDrawer from "../components/LessonDrawer.astro";
import Objectives from "../components/mdx/Objectives.astro";
import LessonComplete from "../components/LessonComplete.tsx";
import { MODULE_BY_SLUG } from "../lib/curriculum";
import { lessonHref } from "../lib/paths";
import { ChevronLeft, ChevronRight } from "../components/icons";
import type { Lesson, Neighbours } from "../lib/lessons";
import type { MarkdownHeading } from "astro";

interface Props {
  lesson: Lesson;
  nav: Neighbours;
  headings: MarkdownHeading[];
}

const { lesson, nav, headings } = Astro.props;
const { data } = lesson;
const module = MODULE_BY_SLUG.get(data.module);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={data.title} description={data.description} bare>
  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-5 py-10 lg:grid-cols-[240px_minmax(0,1fr)] xl:grid-cols-[240px_minmax(0,1fr)_200px]">
    <!-- Course contents -->
    <aside class="hidden lg:block" data-pagefind-ignore>
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
        <Sidebar currentId={lesson.id} />
      </div>
    </aside>

    <!-- Lesson -->
    <article class="min-w-0">
      <div class="mb-4 lg:hidden" data-pagefind-ignore>
        <LessonDrawer currentId={lesson.id} />
      </div>

      <p class="mb-2 flex flex-wrap items-center gap-2 text-[12px]" style="color: var(--text-faint)">
        <span style="color: var(--accent)">{module?.title}</span>
        <span>·</span>
        <span>Lesson {nav.position} of {nav.total}</span>
        <span>·</span>
        <span class="capitalize">{data.level}</span>
      </p>

      <h1 class="text-3xl font-bold sm:text-4xl" style="color: var(--text)">{data.title}</h1>
      <p class="mt-3 text-[17px] leading-relaxed" style="color: var(--text-muted)">{data.description}</p>

      <hr class="my-7" style="border-color: var(--border)" />

      <Objectives items={data.objectives} minutes={data.minutes} />

      <div class="prose-lesson" data-pagefind-body data-pagefind-meta={`title:${data.title}`}>
        <slot />
      </div>

      <LessonComplete
        client:load
        slug={lesson.id}
        nextHref={nav.next ? lessonHref(nav.next.id) : undefined}
        nextTitle={nav.next?.data.title}
      />

      <!-- Prev / next -->
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" data-pagefind-ignore>
        {
          nav.previous ? (
            <a
              href={lessonHref(nav.previous.id)}
              class="card hover-card flex flex-col gap-1 p-4 transition-colors"
              style="border-color: var(--border)"
            >
              <span class="flex items-center gap-1 text-[11px] uppercase tracking-wider" style="color: var(--text-faint)">
                <ChevronLeft width={12} height={12} /> Previous
              </span>
              <span class="font-medium" style="color: var(--text)">{nav.previous.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          nav.next && (
            <a
              href={lessonHref(nav.next.id)}
              class="card hover-card flex flex-col gap-1 p-4 text-right transition-colors sm:col-start-2"
              style="border-color: var(--border)"
            >
              <span class="flex items-center justify-end gap-1 text-[11px] uppercase tracking-wider" style="color: var(--text-faint)">
                Next <ChevronRight width={12} height={12} />
              </span>
              <span class="font-medium" style="color: var(--text)">{nav.next.data.title}</span>
            </a>
          )
        }
      </nav>
    </article>

    <!-- On this page -->
    <aside class="hidden xl:block" data-pagefind-ignore>
      {
        toc.length > 1 && (
          <div class="sticky top-20 text-[13px]">
            <p class="mb-2 text-[11px] font-bold uppercase tracking-wider" style="color: var(--text-faint)">
              On this page
            </p>
            <ul class="space-y-1.5">
              {toc.map((heading) => (
                <li style={heading.depth === 3 ? "padding-left: 0.75rem" : ""}>
                  <a href={`#${heading.slug}`} class="block hover:underline" style="color: var(--text-muted)">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
</BaseLayout>
